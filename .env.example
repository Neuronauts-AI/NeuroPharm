# ============================================
# Neuropharm — Ortam Değişkenleri
# Bu dosyayı .env olarak kopyalayın ve doldurun.
# Railway/Docker'da bunları servis değişkeni olarak tanımlayın.
# ============================================

# ── OpenRouter (zorunlu) ─────────────────────────────────────
# Klinik değerlendirmeyi üreten model bu anahtar üzerinden çağrılır.
# Anahtar: https://openrouter.ai
# Kod OPENROUTER_API_KEY veya OPEN_ROUTER_API_KEY isimlerinden birini kabul eder.
# NOT: docker-compose.yml, host'taki OPEN_ROUTER_API_KEY değişkenini okur.
OPENROUTER_API_KEY=

# ── Giriş parolası (üretimde zorunlu) ────────────────────────
# Uygulamanın tamamı tek bir paylaşılan parolayla korunur.
# AYARLANMAZSA kod içindeki varsayılana düşülür — bu depo public
# olduğu için o varsayılan herkese açıktır. Üretimde mutlaka doldurun.
APP_LOGIN_PASSWORD=

# ── Model seçimi (opsiyonel) ─────────────────────────────────
# Varsayılan model. Arayüzden de değiştirilebilir; değişiklik
# data/runtime-model.json ve bu dosyaya yazılır.
LLM_MODEL=anthropic/claude-sonnet-4.6

# Şu an tek desteklenen sağlayıcı "openrouter". Başka bir değer
# verilse de openrouter'a düşülür.
DEFAULT_LLM_PROVIDER=openrouter

# ── Servisler arası (opsiyonel) ──────────────────────────────
# Next.js'in FastAPI backend'i bulduğu adres.
# Yerel geliştirme: http://localhost:8081
PYTHON_API_URL=http://localhost:8081
